  m_Script: {fileID: 11500000, guid: 5b5cb4fb92392a7928604dd6e5764340, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::IntroStoryHandler
  storyCues:
  - startTime: 2.127
    endTime: 6.414
    message: In the ancient territory of Vadaland, there was a brave boy.
  - startTime: 7.052
    endTime: 8.573
    message: His name was Jasu.
  - startTime: 9.427
    endTime: 11.373
    message: He was the bravest among his village.
  - startTime: 12.25
    endTime: 18.151
    message: One day, he dreamt of having the Red Gemstone, which is considered sacred
      by everyone in Vadaland.
  - startTime: 19.119
    endTime: 22.013
    message: Legends say the stone granted the ones, who touch it...
  - startTime: 22.492
    endTime: 28.016
    message: ... a powerful superpower, that could make otherwise impossible dreams
      into reality.
  alphaDuration: 0.1
  mainGameEntry: {fileID: 1808706111}
  credits:
  - startTime: 1
    duration: 1
    creditureType: 1
    role: A game by
